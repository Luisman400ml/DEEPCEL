A31[j+31..j] = $6C48A50F; 
IF (m == 1) THEN A31[j+31..j] = $FFF7FFFF; 
k = 32 + V1;
DRSCAN k, A31[k-1..0];
WAIT IDLE, 3 CYCLES, 320 USEC, IDLE;
A18[9..0] = $307;
CALL L458;
WAIT IDLE, 16 CYCLES, IDLE;
DRSCAN V0, A29[V1..0], CAPTURE A31[V1..0];
