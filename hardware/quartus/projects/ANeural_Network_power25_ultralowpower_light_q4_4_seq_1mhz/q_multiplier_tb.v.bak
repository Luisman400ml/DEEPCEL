module q_multiplier_tb();

wire signed [15:0] a;
wire signed [15:0] b;
wire signed [15:0] product;


 //instance du module 
 q_multiplier uut(
   .a(a),
	.b(b),
	.product(product)
	);
	
initial begin
// Test 1: 2.0 * 2.0 = 4.0
        // En Q8.8, 2.0 est 2 * 256 = 512 (0x0200)
        a = 16'h0200; b = 16'h0200; 
        #10; // Attendre 10ns
        
        // Test 2: 0.5 * 4.0 = 2.0
        // 0.5 est 128 (0x0080), 4.0 est 1024 (0x0400)
        a = 16'h0080; b = 16'h0400;
        #10;

        $stop; // Arrête la simulation
		  end 
endmodule

	
	