Library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;


entity incrementation is 
    port(
	     clk: in std_logic;
	     read_data: in unsigned(7 downto 0);
		  write_data: out unsigned(8 downto 0)
		  );
end entity;


architecture behavior of incrementation is 

begin
  process(clk,read_data)
  begin
      if rising_edge(clk) then
		   write_data=read_data +1 ;
		end ;
 end process;
end architecture;

		  