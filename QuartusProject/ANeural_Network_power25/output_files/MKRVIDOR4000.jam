A18[9..0] = $1EE;
CALL L458;

L1095:

CALL L107;

POP i;

L146:

NEXT i;

PREIR 0;
POSTIR 0;
PREDR 0;
POSTDR 0;

IF (V42 != 0) THEN
GOTO L147;

V76 = 1;

L147:

ENDPROC;

































































































PROCEDURE L458 USES DEVICE_DATA, TEMP_DATA;

PUSH i;
PUSH j;
PUSH l;
V41 = 0;
V27 = 0;

IF (!V56) THEN GOTO L459;

V56 = 0;
V41 = 50;

