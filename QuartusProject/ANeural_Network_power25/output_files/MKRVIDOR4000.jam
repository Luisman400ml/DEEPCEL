IF (((A17[i] & 128) == 0) || (V230 == 0)) THEN
GOTO L145;

A18[9..0] = $00D;
CALL L458;

WAIT 2500 USEC;

L145:

A18[9..0] = $002;
CALL L458;

FOR i = 0 TO 20;
WAIT IDLE, 512 CYCLES, 512 USEC, IDLE;
NEXT i;

