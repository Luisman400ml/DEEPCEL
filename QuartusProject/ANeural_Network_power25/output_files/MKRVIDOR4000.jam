IF ((A17[i] & 1) != 0) THEN
A32[(V27 + 9)..V27] = $03E;

V27 = V27 + 10;
GOTO L465;

L461:

IF (!V57) THEN GOTO L462;


A32[(V27 + 9)..V27] = $02A;

V27 = V27 + 10;
GOTO L465;

L462:

l = 0;
