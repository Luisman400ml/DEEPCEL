IF ((A17[i] & 8) != 0) THEN GOTO L460;
IF (((A17[i] & V4) != 0) &&
((A17[i] & 4) != 0)) THEN GOTO L462;

A33[(A25[i] - 1)..0] = A39[(A25[i] - 1)..0];

IF (((A17[i] & 1) != 0) &&
((A17[i] & 4) != 0)) THEN
A33[(A25[i] - 1)..0] = $03E;

A32[(V27 + (A25[i] - 1))..V27] = A33[(A25[i] - 1)..0];

V27 = V27 + A25[i];
GOTO L465;

L460:

IF ((A17[i] & 2) != 0) THEN GOTO L461;

